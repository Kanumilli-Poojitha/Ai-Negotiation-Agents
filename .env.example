# URL of the Ollama service (use the compose service name inside Docker)
OLLAMA_BASE_URL=http://ollama:11434
# Model pulled into Ollama (docker exec -it ollama ollama pull llama3)
OLLAMA_MODEL=llama3
# Sampling temperature (lower = more deterministic)
OLLAMA_TEMPERATURE=0.3
# Per-request timeout in seconds
OLLAMA_TIMEOUT=120
